# Copy to .env and fill in. Never commit .env.
# deploy.py passes this file to the app container with --env-file (no quotes around values).

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Add every HTTPS origin the site is opened from (tunnel or production), or form posts fail CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

# Postgres container (hookd_postgres). deploy.py creates the database and user from these on first start, and
# the app connects with them. Changing them later needs a manual change inside Postgres.
POSTGRES_DB=hookd
POSTGRES_USER=hookd
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Redis container (hookd_redis): Celery broker (db 0) and cache (db 1). After changing the password run
# python3 deploy.py services --recreate
REDIS_PASSWORD=change-me-to-a-long-random-string

# Public base URL of the site (default OAuth redirect URIs, and the URLs Meta downloads publish uploads from).
# Publishing needs HTTPS: locally set it to the tunnel URL, for example https://<id>.ngrok-free.dev
APP_URL=http://localhost:8000

# Outgoing email via GoDaddy Workspace Email (access requests to support@hookd.world).
# Leave EMAIL_HOST empty to print mail to the console instead of sending it.
# Port 465 = SSL (default), 587 = STARTTLS. Mail is sent from EMAIL_HOST_USER so it passes SPF and DMARC.
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_HOST_USER=support@hookd.world
# The mailbox password (GoDaddy > Email & Office dashboard to reset it)
EMAIL_HOST_PASSWORD=

# Encryption for OAuth tokens at rest.
# Generate inside the container: python manage.py generate_encryption_key
# Comma separated, newest first, to support key rotation.
FIELD_ENCRYPTION_KEYS=

# Instagram API with Unified Login. Meta app ID and secret: App settings > Basic.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Use cases > Instagram API > API setup with Unified login > 1. Configure your app > Configuration ID
INSTAGRAM_LOGIN_CONFIG_ID=
# Must be registered under the same step's "Redirect URL". Must be HTTPS.
# Local: use a tunnel to port 8000, for example https://<id>.ngrok-free.dev/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=https://hookd.world/auth/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v27.0
# Any random string. Paste the same value into "3. Configure webhooks" > Verify token in the Meta app.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Webhook fields every connected account is subscribed to, comma separated. Default: comments.
# Add messages (DMs, story replies, story mentions) once the login configuration has instagram_manage_messages,
# then run: python manage.py subscribe_webhooks
INSTAGRAM_WEBHOOK_FIELDS=comments


# Claude API for all AI text: post plans and captions, comment replies, brain facts. Key: https://platform.claude.com/settings/keys
# Without it the post studio shows a setup message and the reply agent uses the word matching simulated engine.
ANTHROPIC_API_KEY=
# Optional model overrides. Default: claude-haiku-5-5 for both.
CLAUDE_COPY_MODEL=
CLAUDE_REPLY_MODEL=

# Google AI Studio (Gemini API) for the post studio photos. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default: gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=
